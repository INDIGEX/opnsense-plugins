#!/bin/sh
#
# PROVIDE: osnetbird
# REQUIRE: SERVERS
# KEYWORD: shutdown
#
# Multi-instance NetBird launcher, shipped by the plugin because the
# netbird port already owns /usr/local/etc/rc.d/netbird (single instance).
# The plugin's rc.conf.d template always disables that script and drives
# every configured instance through this one instead.
#
# Add the following lines to /etc/rc.conf to enable an instance (normally
# generated by the plugin's rc.conf.d template, not hand edited):
#
# osnetbird_enable (bool):		Set it to YES to run any instance on startup.
# osnetbird_instances (str):		Space separated list of instance ids.
# osnetbird_<id>_config (path):		Path to that instance's config.json.
# osnetbird_<id>_socket (path):		Path to that instance's daemon socket.
# osnetbird_<id>_tundev (str):		Name of that instance's tunnel device.
# osnetbird_loglevel (str):		Shared log level for all instances.

. /etc/rc.subr

name="osnetbird"
rcvar="osnetbird_enable"

load_rc_config "$name"

: ${osnetbird_enable:="NO"}
: ${osnetbird_loglevel:="info"}

# Normalize dashes to underscores: callers may pass either the raw model
# uuid (with dashes, e.g. straight from the GUI/API) or the uuid_safe form
# already used for rc.conf.d variable names; a dash is not a valid shell
# variable name character, so this must happen before it's used in one.
id=$(echo "$2" | tr - _)

if [ -z "$id" ]; then
	# No instance id given: dispatch to every configured instance.
	_return=0
	for i in $osnetbird_instances; do
		$0 "$1" "$i" || _return=1
	done
	exit $_return
fi

eval osnetbird_config=\$osnetbird_${id}_config
eval osnetbird_socket=\$osnetbird_${id}_socket
eval osnetbird_tundev=\$osnetbird_${id}_tundev

: ${osnetbird_config:="/var/db/netbird/${id}/config.json"}
: ${osnetbird_socket:="/var/run/netbird_${id}.sock"}
: ${osnetbird_tundev:="wt0"}

pidfile="/var/run/netbird_${id}.pid"
command="/usr/sbin/daemon"
daemon_args="-P ${pidfile} -r -t \"${name}: ${id}\""
command_args="${daemon_args} /usr/local/bin/netbird service run --config ${osnetbird_config} --log-level ${osnetbird_loglevel} --daemon-addr unix://${osnetbird_socket} --log-file syslog"
start_precmd="osnetbird_start_precmd"
start_postcmd="osnetbird_start_postcmd"
stop_postcmd="osnetbird_stop_postcmd"

osnetbird_start_precmd()
{
	logger -s -t netbird "Starting ${name} instance ${id}."
	/usr/local/sbin/pluginctl -c netbird_sync_config
	# Check for orphaned tunnel interface and destroy it
	if /sbin/ifconfig ${osnetbird_tundev} >/dev/null 2>&1; then
		if ! /sbin/ifconfig ${osnetbird_tundev} | fgrep -qw PID; then
			logger -s -t netbird "Found orphaned tunnel interface ${osnetbird_tundev}, destroying"
			/sbin/ifconfig ${osnetbird_tundev} destroy
		fi
	fi
}

osnetbird_start_postcmd()
{
	# Guards against a CARP BACKUP node reconnecting this instance after
	# any service start (boot, HA config-sync restart, GUI/API start).
	# No-op for instances that don't have CARP support enabled.
	/usr/local/opnsense/scripts/netbird/carp_guard.php "${id}"
}

osnetbird_stop_postcmd()
{
	if /sbin/ifconfig ${osnetbird_tundev} >/dev/null 2>&1; then
		logger -s -t netbird "Destroying tunnel interface ${osnetbird_tundev}"
		/sbin/ifconfig ${osnetbird_tundev} destroy || \
			logger -s -t netbird "Failed to destroy interface ${osnetbird_tundev}"
	fi
}

run_rc_command "$1"
